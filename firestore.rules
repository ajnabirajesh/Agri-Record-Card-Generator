rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId
    // Fields:
    //   - email: string (required)
    //   - role: string (required) - 'user' or 'admin'
    //   - createdAt: timestamp
    //
    // Collection: cards
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required) - The UID of the user who generated the card.
    //   - userEmail: string (optional) - The email of the user who generated the card.
    //   - farmerData: string (required) - JSON stringified representation of the FarmerData object.
    //   - transactionId: string (required) - The Razorpay transaction/order ID.
    //   - createdAt: timestamp (required) - The timestamp when the card was generated.
    //
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          request.auth.token.email == "rajeshkumar1112000@gmail.com" ||
          request.auth.token.email == "admin@agrirecord.com");
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }
    
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }
    
    function isValidUser() {
      return hasRequiredFields(['email', 'role']) &&
             request.resource.data.email is string &&
             request.resource.data.role in ['user', 'admin'];
    }
    
    function isValidCard() {
      return hasRequiredFields(['userId', 'farmerData', 'transactionId', 'createdAt']) &&
             request.resource.data.userId == request.auth.uid &&
             request.resource.data.farmerData is string &&
             request.resource.data.farmerData.size() > 0 &&
             request.resource.data.farmerData.size() < 1000000 &&
             request.resource.data.transactionId is string &&
             request.resource.data.transactionId.size() > 0 &&
             request.resource.data.transactionId.size() < 100 &&
             request.resource.data.createdAt is timestamp &&
             (!('userEmail' in request.resource.data) || request.resource.data.userEmail == null || request.resource.data.userEmail is string);
    }

    match /payment_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
    }

    function isOwnerUpdatingFreeCredits(userId) {
      // Must be owner, can only change freeCredits, must decrement by exactly 1, and current val > 0
      return isOwner(userId) && 
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['freeCredits']) &&
             request.resource.data.freeCredits == resource.data.freeCredits - 1 &&
             resource.data.freeCredits > 0;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser() && (request.resource.data.role == 'user' || isAdmin());
      allow update: if (isAdmin() && (isValidUser() || !request.resource.data.keys().hasAny(['email', 'role']))) || isOwnerUpdatingFreeCredits(userId);
      allow delete: if isAdmin();
    }

    match /cards/{cardId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidCard();
      allow update: if (isDocOwner() || isAdmin()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted']) && request.resource.data.isDeleted == true || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['farmerData'])); 
      allow delete: if isDocOwner() || isAdmin(); // Allow users to delete their own cards, admins can delete any
    }
  }
}
